{
  "name": "server",
  "version": "1.0.0",
  "description": "Cricket Auction Platform - backend (persistent, multi-room)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec \"node --experimental-sqlite --import tsx src/index.ts\"",
    "seed": "node --experimental-sqlite --import tsx src/runSeed.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "ws": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
